<view class="page">
  <mode-banner></mode-banner>
  <ui-state loading="{{loading}}" error="{{error}}" bind:retry="retry" />
  <block wx:if="{{record}}">
    <view class="success-circle"><line-icon name="check" size="84" /></view>
    <view class="title center">模拟上报成功</view>
    <view class="subtitle center">你的这份关心，让社区多一份安心</view>
    <view class="gap" />
    <ui-card>
      <view class="row between">
        <text class="muted">演示编号</text>
        <text class="small">{{record.number}}</text>
      </view>
      <view class="divider" />
      <view class="row between">
        <text class="muted">当前状态</text>
        <status-tag status="{{record.status}}" label="{{record.statusName}}" />
      </view>
      <view class="divider" />
      <view class="row between">
        <text class="muted">提交时间</text>
        <text class="small">{{record.timeText}}</text>
      </view>
    </ui-card>
    <ui-card title="本次上报"><view class="strong">{{record.typeName}} · {{record.location}}</view><view class="record-description body-text">{{record.description}}</view></ui-card>
    <view class="hint">
      {{connected ? '已保存到评审演示服务器，可在详情和“我的上报”查看；不会触发真实物业告警。' : '已生成本地演示记录，可在详情和“我的上报”查看。未提交到真实物业系统。'}}
    </view>
    <ui-button
      label="查看本次上报"
      id="view-report"
      data-url="/pages/report-detail/report-detail?id={{record.id}}"
      bind:action="go"
    />
    <view class="gap" />
    <ui-button
      label="返回首页"
      variant="plain"
      data-url="/pages/index/index"
      bind:action="go"
    />
  </block>
</view>
