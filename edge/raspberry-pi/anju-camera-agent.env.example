# Stored as /etc/anju-camera-agent.env on the Raspberry Pi (chmod 600).
CAMERA_SERVER_URL=https://example.com
CAMERA_INGEST_KEY=replace-with-the-server-camera-ingest-key
CAMERA_ID=CAM-RPI-01
YOLO_MODEL_PATH=/home/pi/models/fire-smoke/yolov8n-fire-smoke.onnx
CAMERA_FPS=4
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# 允许 0、90、180、270；摄像头倒装时使用 180。
CAMERA_ROTATION=0
CAMERA_JPEG_QUALITY=78
YOLO_IMAGE_SIZE=416
YOLO_INFERENCE_CONFIDENCE=0.25
YOLO_DECISION_THRESHOLD=0.60
YOLO_CONFIRM_FRAMES=3
YOLO_CLEAR_FRAMES=8
CAMERA_UPLOAD_TIMEOUT=8
MPLCONFIGDIR=/tmp/anju-matplotlib
YOLO_CONFIG_DIR=/tmp/anju-ultralytics
