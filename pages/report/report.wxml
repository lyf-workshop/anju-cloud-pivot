<view class="page {{keyboardOpen?'':'has-actions'}}">
  <view class="hint row" style="background:#fff0eb;color:#d44730;margin-top:0"><line-icon name="camera-active" size="28"/><text>发现身边隐患，拍照反馈更清晰</text></view>
  <view class="field"><view class="field-label">隐患类型<text class="required">*</text></view><view class="type-options"><button wx:for="{{types}}" wx:key="id" class="type-option {{typeIndex===index?'active':''}}" data-index="{{index}}" bindtap="type" disabled="{{busy}}">{{item.name}}</button></view></view>
  <view class="field"><view class="field-label">隐患位置<text class="required">*</text></view><view class="picker" style="background:white;border:0" bindtap="toggleLocation"><text class="grow">{{locationText || '选择所在楼栋和楼层'}}</text><text>›</text></view><view wx:if="{{showLocation}}" class="floor-controls"><location-picker value="{{preferred}}" disabled="{{busy}}" bind:change="location"/></view><view class="gap" style="height:12rpx"/><input class="input" disabled="{{busy}}" value="{{form.location}}" data-field="location" bindinput="input" bindkeyboardheightchange="keyboard" maxlength="160" placeholder="补充位置，如东侧公共走廊" adjust-position cursor-spacing="32"/></view>
  <view class="field"><view class="row between field-label"><text>现场照片</text><text class="muted">{{photos.length}} / 3</text></view><view class="photo-grid"><view class="photo-box" wx:for="{{photos}}" wx:key="path"><image class="photo" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="preview"/><button class="photo-remove" data-index="{{index}}" bindtap="remove" disabled="{{busy}}">×</button></view><button wx:if="{{photos.length<3}}" class="photo-add" bindtap="choose" disabled="{{busy}}"><line-icon name="camera" size="40"/><text>拍照 / 相册</text></button></view><view class="field-note">选填，仅在本机预览，不会上传。</view></view>
  <view class="field"><view class="field-label">情况描述<text class="required">*</text></view><textarea class="textarea" value="{{form.description}}" disabled="{{busy}}" data-field="description" bindinput="input" bindkeyboardheightchange="keyboard" maxlength="500" placeholder="描述发现的问题，至少5个字" adjust-position cursor-spacing="60"/><view class="field-note" style="text-align:right">{{form.description.length}} / 500</view></view>
  <view class="field"><view class="row between field-label"><text>联系电话</text><text class="muted">选填，演示填写即可</text></view><input class="input" value="{{form.contact}}" disabled="{{busy}}" data-field="contact" bindinput="input" bindkeyboardheightchange="keyboard" maxlength="30" placeholder="无需提供真实手机号" adjust-position cursor-spacing="80"/></view>
  <ui-state error="{{error}}" bind:retry="retry" compact/><mode-banner/>
  <view class="{{keyboardOpen?'':'fixed-actions'}}"><ui-button id="submit-report" label="提交演示上报" loading="{{busy}}" bind:action="submit"/></view>
</view>
