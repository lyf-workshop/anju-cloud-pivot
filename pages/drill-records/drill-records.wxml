<view class="page has-actions">
  <view class="title">每一次练习，都多一份准备</view><view class="subtitle">查看已完成的线上模拟演练</view>
  <view class="history-stats stats"><view class="stat"><view class="stat-number success">{{stats.completedCount}}</view><view class="stat-label">已完成演练</view></view><view class="stat"><view class="stat-number">{{durationText || '00:00'}}</view><view class="stat-label">累计参与时长</view></view></view>
  <view class="section"><view class="section-title">最近记录</view></view>
  <ui-state loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !items.length}}" text="还没有演练记录，开始一次线上练习吧" bind:retry="retry"/>
  <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row between"><view class="record-title grow">{{item.snapshot.title}}</view><status-tag status="{{item.status}}" label="{{item.statusName}}"/></view><view class="record-meta">{{item.snapshot.communityName}} · {{item.snapshot.buildingName}} · {{item.snapshot.floorNumber}}层</view><view class="divider"/><view class="record-footer"><text>{{item.timeText}}</text><text>{{item.durationText}} · {{item.completedCount}}/{{item.totalSteps}}步骤</text></view><view class="record-footer"><text class="pill">线上模拟</text><text class="view-link">{{item.status==='in_progress'?'继续体验':'查看总结'}} ›</text></view></view>
  <ui-button wx:if="{{items.length<total}}" label="加载更多" loading="{{busy}}" variant="plain" bind:action="more"/>
  <mode-banner/>
  <view class="fixed-actions"><ui-button label="开始一次新演练" variant="plain" data-url="/pages/building/building" bind:action="go"/></view>
</view>
