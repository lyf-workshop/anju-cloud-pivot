<view class="page">
  <ui-state loading="{{loading}}" error="{{error}}" bind:retry="retry" compact />
  <view class="row between home-location"><picker range="{{communities}}" range-key="name" value="{{communityIndex}}" bindchange="community"><view class="row"><line-icon name="pin-active" size="28"/><text>{{home.community.name || '云栖花园'}} ⌄</text></view></picker><text class="pill">本地演示住户</text></view>
  <view class="home-hero"><view class="grow"><view class="eyebrow">社区安全 · 每日一看</view><view class="hero-title">把安全，<view/>带回每一个家。</view><view class="hero-note">一起发现身边的小隐患</view></view><image src="/assets/illustrations/building.png" mode="aspectFit" /></view>
  <view class="announcement-strip row" data-url="/pages/notices/notices" bindtap="go"><text class="accent">公告</text><text class="grow">{{home.announcements[0].title || '社区安全提示'}}</text><text class="chevron">›</text></view>
  <view class="section"><view class="section-title">社区服务</view></view>
  <view class="service-grid"><button wx:for="{{services}}" wx:key="title" class="service-tile" data-url="{{item.url}}" data-title="{{item.title}}" bindtap="service"><line-icon name="{{item.icon}}" size="40"/><text>{{item.title}}</text></button></view>
  <view class="safety-strip" data-url="/pages/building/building" bindtap="go"><view class="row"><line-icon name="shield" size="30"/><text class="strong grow">平安社区，你我共建</text><text class="small">查看 ›</text></view><view class="muted">查看楼栋信息，在线认识安全出口与集合点</view></view>
  <view class="card" style="padding-top:8rpx;padding-bottom:8rpx"><button class="list-row" data-url="/pages/emergency/emergency" bindtap="go"><view class="icon-box"><line-icon name="phone" size="34"/></view><view class="grow"><view class="strong">联系物业管家</view><view class="muted">隐患咨询 · 日常服务</view></view><text class="chevron">›</text></button></view>
  <view class="section"><text class="section-title">我的社区</text><text class="muted">{{home.buildings.length || 0}}栋 · {{home.deviceCount || 0}}台示例设备</text></view>
  <view class="card"><button wx:for="{{home.buildings}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="building"><line-icon name="building" size="32"/><text class="grow">{{item.name}}</text><text class="chevron">›</text></button></view>
  <mode-banner/>
</view>
