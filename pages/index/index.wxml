<view class="page home-page">
  <ui-state loading="{{loading}}" error="{{error}}" bind:retry="retry" compact />

  <!-- 顶部氛围层：门头实景半透明底 + 原有文案 -->
  <view class="home-cover">
    <image
      class="home-cover-bg"
      src="/assets/illustrations/home-gate-cover.jpg"
      mode="aspectFill"
    />
    <view class="home-cover-veil" aria-hidden="true" />
    <view class="row between home-cover-top">
      <picker range="{{communities}}" range-key="name" value="{{communityIndex}}" bindchange="community">
        <view class="home-cover-chip row">
          <line-icon name="pin-active" size="26" />
          <text>{{home.community.name || '云栖花园'}} ⌄</text>
        </view>
      </picker>
      <text class="home-cover-pill">本地演示住户</text>
    </view>
    <view class="home-cover-body">
      <view class="home-cover-copy">
        <view class="home-cover-eyebrow">安居云枢 · 社区安全</view>
        <view class="home-cover-title">把安全，带回每一个家</view>
        <view class="home-cover-note">守护邻里日常，从每一次安心开始</view>
      </view>
    </view>
    <view class="home-cover-wave" aria-hidden="true" />
  </view>

  <!-- 内容叠层：公告 / 轮播 / 下方模块上叠在氛围层上 -->
  <view class="home-sheet">
    <!-- 公告：内容与逻辑保持不变 -->
    <view class="home-notice-card row" data-url="/pages/notices/notices" bindtap="go">
      <view class="home-notice-horn">
        <text class="home-notice-horn-icon">📢</text>
      </view>
      <swiper
        class="home-notice-swiper grow"
        vertical="{{true}}"
        autoplay="{{true}}"
        circular="{{true}}"
        interval="6000"
        duration="400"
        indicator-dots="{{false}}"
      >
        <swiper-item wx:for="{{home.announcements}}" wx:key="id">
          <view class="home-notice-line">{{item.title}}</view>
        </swiper-item>
        <swiper-item wx:if="{{!home.announcements.length}}">
          <view class="home-notice-line">社区安全提示</view>
        </swiper-item>
      </swiper>
      <text class="home-notice-arrow">›</text>
    </view>

    <!-- 轮播：图片与切换逻辑保持不变 -->
    <view
      class="home-hero-wrap"
      bindtouchstart="pauseHero"
      bindtouchend="resumeHero"
      bindtouchcancel="resumeHero"
      bindmouseenter="pauseHero"
      bindmouseleave="resumeHero"
    >
      <swiper
        class="home-swiper"
        style="height: {{heroHeight}}px;"
        autoplay="{{heroAutoplay}}"
        interval="5000"
        duration="500"
        circular="{{true}}"
        indicator-dots="{{true}}"
        indicator-color="rgba(255, 255, 255, 0.45)"
        indicator-active-color="#ffffff"
        current="{{heroCurrent}}"
        bindchange="onHeroChange"
      >
        <swiper-item wx:for="{{heroSlides}}" wx:key="id">
          <view class="home-hero-card">
            <image
              class="home-hero-poster"
              src="{{item.image}}"
              mode="aspectFill"
            />
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="section"><view class="section-title">社区服务</view></view>
    <view class="service-grid"><button wx:for="{{services}}" wx:key="title" class="service-tile" data-url="{{item.url}}" data-title="{{item.title}}" bindtap="service"><line-icon name="{{item.icon}}" size="40"/><text>{{item.title}}</text></button></view>
    <view class="safety-strip" data-url="/pages/building/building" bindtap="go"><view class="row"><line-icon name="shield" size="30"/><text class="strong grow">平安社区，你我共建</text><text class="small">查看 ›</text></view><view class="muted">查看楼栋信息，在线认识安全出口与集合点</view></view>
    <view class="card" style="padding-top:8rpx;padding-bottom:8rpx"><button class="list-row" data-url="/pages/emergency/emergency" bindtap="go"><view class="icon-box"><line-icon name="phone" size="34"/></view><view class="grow"><view class="strong">联系物业管家</view><view class="muted">隐患咨询 · 日常服务</view></view><text class="chevron">›</text></button></view>
    <view class="section"><text class="section-title">我的社区</text><text class="muted">{{home.buildings.length || 0}}栋 · {{home.deviceCount || 0}}台示例设备</text></view>
    <view class="card"><button wx:for="{{home.buildings}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="building"><line-icon name="building" size="32"/><text class="grow">{{item.name}}</text><text class="chevron">›</text></button></view>
    <mode-banner></mode-banner>
  </view>
</view>
