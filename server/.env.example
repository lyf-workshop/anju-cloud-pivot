# Copy to server/.env. No secrets belong in the mini program.
NODE_ENV=development
DATA_MODE=demo
# On an HTTPS public preview, disable resident development login and use Secure staff cookies.
# Do not use this for actual residents or live alarm operations.
PUBLIC_DEMO=false
# Enables the Windows/Android judge app's anonymous, scoped demo sessions.
# PUBLIC_DEMO=true also enables this automatically.
DEMO_EXPERIENCE=false
HOST=127.0.0.1
PORT=3000
# Default: server/data/demo.sqlite or server/data/production.sqlite
# DATABASE_PATH=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SESSION_TTL_HOURS=168
# Property sessions are shorter by default; "remember this device" uses the second value.
STAFF_SESSION_TTL_HOURS=12
STAFF_REMEMBER_SESSION_TTL_HOURS=168
STAFF_LOCK_ATTEMPTS=5
STAFF_LOCK_MINUTES=15
# Keep judge sessions available throughout the review window (default 90 days).
DEMO_SESSION_TTL_HOURS=2160
DEVICE_ONLINE_SECONDS=300
READING_FRESH_SECONDS=600
PROPERTY_PHONE=
PROPERTY_PHONE_VERIFIED=false
PROPERTY_UPDATED_AT=
# Formal agreements must be supplied and reviewed before production login.
LEGAL_APPROVED=false
LEGAL_VERSION=draft-2026-09
# JSON file containing terms and privacy strings (see docs/production-catalog.example.json)
LEGAL_FILE=
# Explicitly configured service catalog JSON, never demo fixtures in production.
CATALOG_FILE=
# Server-to-server only; keep empty to disable hardware ingestion.
DEVICE_INGEST_KEY=
# Raspberry Pi camera uses a separate secret. Generate a long random value and
# configure the same value only in the Pi's protected EnvironmentFile.
CAMERA_INGEST_KEY=
CAMERA_COMMUNITY_ID=community-demo
CAMERA_STALE_SECONDS=10
CAMERA_MAX_FRAME_BYTES=524288
# Local web and API share the same port. Add explicit LAN origin only if needed.
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Exact origins used by the installed clients plus local browser verification.
CLIENT_ORIGINS=app://anju,https://localhost,http://localhost,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
# Local-only demo account: property-demo. PUBLIC_DEMO=true requires a unique
# password of at least 16 characters generated and stored on the server.
# Never seeded in production.
DEMO_STAFF_PASSWORD=AnjuLocal2026!
# WEB_ROOT=安居云枢网页端(1)/textcursor
# Optional explicit staff provisioning: npm run backend:staff:create.
# Existing usernames are never overwritten. Keep the password out of source control.
STAFF_USERNAME=
STAFF_PASSWORD=
STAFF_NICKNAME=
STAFF_COMMUNITY_ID=community-demo
STAFF_ROLE=operator
# OpenAI-compatible chat API. Keep the key only in server/.env.
# ZHIZENGZENG_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.zhizengzeng.com/v1
# LLM_MODEL=qwen-plus
# AGENT_CAMERA_ID=CAM-RPI-01
